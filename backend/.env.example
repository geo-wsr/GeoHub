# 复制为 backend/.env 后按需修改；.env 已被 .gitignore 忽略，不会提交到仓库。
# 生产环境请改用系统环境变量或服务器的密钥管理，不要落地成本地文件。

# ---- Django 基础 ----
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# ---- 前端站点地址与跨域（GitHub Pages 域名或自定义域名）----
FRONTEND_URL=http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ---- GitHub OAuth（GitHub → Settings → Developer settings → OAuth Apps 创建）----
# 回调地址填：https://<后端域名>/accounts/github/login/callback/
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- 数据库（不填则用本地 SQLite；PaaS / Serverless 必须填）----
# Neon / Supabase / Render 都会给出这种连接串，例如：
# postgresql://user:password@ep-xxx.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ---- 对象存储：Cloudflare R2（或任意 S3 兼容服务）----
# 不填则用本地 media/ 目录；PaaS / Serverless 必须填，否则上传的文件会随实例销毁而丢失
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# R2 形如 https://<account_id>.r2.cloudflarestorage.com
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=auto
# R2 控制台开启「公开访问」后得到的域名，如 pub-xxxx.r2.dev
AWS_S3_CUSTOM_DOMAIN=
# 公开桶保持 false；若改用私有桶要改 true（此时图片需签名 URL，论坛图片会失效）
AWS_QUERYSTRING_AUTH=false

# ---- 部署到 Render 时它会自动注入 RENDER_EXTERNAL_HOSTNAME，无需手动配置 ----
