# 复制为 backend/.env 后按需修改；.env 已被 .gitignore 忽略，不会提交到仓库。
# 生产环境请改用系统环境变量或服务器的密钥管理，不要落地成本地文件。

# ---- Django 基础 ----
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# ---- 前端站点地址与跨域（GitHub Pages 域名或自定义域名）----
FRONTEND_URL=http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ---- GitHub OAuth（GitHub → Settings → Developer settings → OAuth Apps 创建）----
# 回调地址填：https://<后端域名>/accounts/github/login/callback/
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=