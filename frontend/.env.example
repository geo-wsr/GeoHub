# 复制为 .env.local（.gitignore 已忽略）后按需修改；不要提交真实密钥。
#
# 后端接口地址：
#   留空         → 走 vite.config.js 的代理（仅开发期，指向 http://127.0.0.1:8000）
#   http://...   → 直连后端（生产由 GitHub Actions 注入云服务器域名）
VITE_API_BASE_URL=

# 构建资源基础路径（只在 npm run build 时有意义）：
#   交给 Django 托管      → 留空（默认 /static/）
#   GitHub Pages 仓库子路径 → /<仓库名>/
#   GitHub Pages 自定义域名 → /
VITE_BASE_PATH=

# 前端路由前缀（只在 npm run build 时有意义）：
#   交给 Django 托管 → 留空（默认 /，页面由 Django 的 catch-all 在站点根提供）
#   GitHub Pages     → 与 VITE_BASE_PATH 相同，即 /<仓库名>/ 或 /
# 注意：Django 托管时资源在 /static/ 下，但路由前缀必须是 /，两者不能混用
VITE_ROUTER_BASE=
